# ============================================================
# OSINT Workstation — .gitignore
# Unified for CLI orchestrator + optional PySide6 GUI (osint-toolkit)
# ============================================================

# --- Secrets & local configuration (NEVER commit) ---
.env
.env.*
!.env.example
secrets/secrets.env
secrets/*.db
*.key
*.pem
*.p12

# --- Third-party tools vendored at runtime (not source) ---
tools/exiftool-portable/
tools/searxng/
tools/spiderfoot-src/
tools/theHarvester/

# --- Service runtime: venvs, logs, scan DBs, state ---
services/venv-searxng/
services/venv-spiderfoot/
services/logs/
services/spiderfoot-data/
services/services.json

# --- User output: investigations, reports, caches ---
investigations/
reports/
config/source_health.json
logs/http_cache/
logs/*.txt
logs/*.html
logs/*.pdf
logs/*.py
logs/*.json
*.db
*.sqlite
*.sqlite3

# --- Toolkit specific user data ---
workspace/
cases/
exports/
state.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Third-party tools auto-downloaded at runtime ---
vendor/
tools/bin/
downloads/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.tmp

# --- DSH ACL diagnostic artifacts ---
.dsh-acl-recovery/

# --- Media & scraped content (screenshots, images, HTML, PDFs) ---
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.pdf
*.html