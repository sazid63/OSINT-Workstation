# ============================================================
# OSINT Toolkit - environment template
# Copy to `.env` (git-ignored) and fill in what you need.
# Better: enter keys in the app under Settings, which stores
# them in your OS keychain. Nothing here is required.
# ============================================================

# --- Local AI (no key needed) ---
OLLAMA_HOST=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Cloud AI (optional, opt-in; keys stay local) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# --- OpenCode (optional) ---
OPENCODE_BASE_URL=http://localhost:4096
